# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋하지 마세요)

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# PostgreSQL 연결 문자열. Neon 대시보드 > Connect 에서 복사한 값을 그대로 붙여넣으면 됨
# 예: postgresql://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 시작할 때 DB 마이그레이션 자동 적용 (기본 1, 끄려면 0)
AUTO_MIGRATE=1

# (더 이상 필요 없음) 명령어는 봇이 들어간 모든 서버에 자동으로 즉시 등록됩니다
DEV_GUILD_ID=

# 관리자 Discord 사용자 ID, 쉼표로 구분 (Phase 5 관리자 명령어에서 사용)
ADMIN_USER_IDS=

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- PC 수집기 (ProSettings) ----
# 봇(Render)과 PC 수집기 양쪽에 같은 값을 넣습니다. 길고 무작위인 문자열로 만드세요.
# 봇에 설정하면 ProSettings 요청을 PC 수집기에 맡깁니다.
WORKER_TOKEN=
# PC 수집기에서만 사용: 봇 주소 (Render 서비스 URL)
BOT_URL=https://valorant-pro-discord-bot-us-kifs.onrender.com

# /선수 명령어를 모두에게 공개할지 (기본 0 = 준비 중 안내, ADMIN_USER_IDS 의 관리자만 사용 가능)
PLAYER_COMMAND_ENABLED=0

# 자동 갱신(경기 1시간, 진행 중 경기 10분, 팀 2달에 한 번) 사용 여부 (기본 1, 끄려면 0)
SCHEDULER_ENABLED=1
