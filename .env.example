# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋하지 마세요)

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# PostgreSQL 연결 문자열. Neon 대시보드 > Connect 에서 복사한 값을 그대로 붙여넣으면 됨
# 예: postgresql://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 시작할 때 DB 마이그레이션 자동 적용 (기본 1, 끄려면 0)
AUTO_MIGRATE=1

# 개발용 서버 ID. 설정하면 Slash Command가 해당 서버에 즉시 반영됨 (선택)
DEV_GUILD_ID=

# 관리자 Discord 사용자 ID, 쉼표로 구분 (Phase 5 관리자 명령어에서 사용)
ADMIN_USER_IDS=

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
